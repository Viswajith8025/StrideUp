# Supabase (required for auth, persistence, challenges, chat)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App branding
NEXT_PUBLIC_APP_NAME=StrideUp

# Production URL (set when deploying)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# E2E / Playwright (optional — required for npm run test:e2e)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# E2E_USER1_EMAIL=e2e-user1@strideup.test
# E2E_USER1_PASSWORD=StrideUpE2E!1
# E2E_USER2_EMAIL=e2e-user2@strideup.test
# E2E_USER2_PASSWORD=StrideUpE2E!2
# E2E_INACTIVE_EMAIL=e2e-inactive@strideup.test
# E2E_INACTIVE_PASSWORD=StrideUpE2E!3

# Web Push (VAPID public key — safe for client)
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# AI partner (Groq) — server-only, never expose to the client
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional model override (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
